diff --git a/google/genai/_buffered_input.py b/google/genai/_buffered_input.py
new file mode 100644
--- /dev/null
+++ b/google/genai/_buffered_input.py
@@ -0,0 +1,64 @@
+"""A fixed caller-funded input adapter using the standard buffered protocol path."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Callable
+from typing import Any
+
+from websockets.asyncio.client import ClientConnection
+
+from ._bounded_receive import ReceiveUnavailableError
+
+INPUT_BATCH_BYTES = 4096
+
+
+class BufferedClientConnection(ClientConnection, asyncio.BufferedProtocol):
+    """Keep WebSockets' parser and flow control; bound each new plaintext batch.
+
+    The caller owns the backing exclusively through actual context closure and
+    prepays a separate INPUT_BATCH_BYTES allowance for the immutable prefix copy.
+    Neither a callback error nor connection_lost refunds that ownership.
+    """
+
+    def __init__(self, *args: Any, input_storage: bytearray, **kwargs: Any) -> None:
+        if type(input_storage) is not bytearray or len(input_storage) != INPUT_BATCH_BYTES:
+            raise ValueError("4096_byte_input_storage_required")
+        self._input_view = memoryview(input_storage)
+        super().__init__(*args, **kwargs)
+
+    def get_buffer(self, sizehint: int) -> memoryview:
+        # The transport's hint cannot enlarge the caller's prepaid backing.
+        return self._input_view
+
+    def buffer_updated(self, nbytes: int) -> None:
+        if type(nbytes) is not int or not 0 <= nbytes <= INPUT_BATCH_BYTES:
+            raise ValueError("invalid_buffered_input_prefix")
+        # This exact bounded copy avoids exporting a mutable buffer to the parser.
+        # The ordinary parser retains its own copies; the view remains an alias.
+        data = bytes(self._input_view[:nbytes])
+        try:
+            super().data_received(data)
+        finally:
+            del data
+
+    def data_received(self, data: bytes) -> None:
+        # A copied-read transport has already bypassed the intended TLS batching.
+        # Refuse it without invoking the parser or allocating another input copy.
+        raise ReceiveUnavailableError("buffered_input_transport_required")
+
+
+def buffered_connection_factory(storage: bytearray) -> Callable[..., ClientConnection]:
+    """One public connect factory claim, including failed/redirected attempts."""
+    if type(storage) is not bytearray or len(storage) != INPUT_BATCH_BYTES:
+        raise ValueError("4096_byte_input_storage_required")
+    claimed = False
+
+    def create_connection(*args: Any, **kwargs: Any) -> ClientConnection:
+        nonlocal claimed
+        if claimed:
+            raise ReceiveUnavailableError("buffered_input_owner_already_claimed")
+        claimed = True
+        return BufferedClientConnection(*args, input_storage=storage, **kwargs)
+
+    return create_connection
