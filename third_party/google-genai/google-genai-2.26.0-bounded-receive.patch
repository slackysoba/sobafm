--- /dev/null
+++ b/google/genai/json_shape_preflight.py
@@ -0,0 +1,147 @@
+"""Uninstalled constant-state shape guard before stock JSON parsing.
+
+This is deliberately not a syntax validator. It scans UTF-8 bytes in place,
+counts lexical shape, and only rejects. json.loads still validates the input.
+The caller owns the input and must prevent mutation/reuse until parsing ends.
+"""
+
+from __future__ import annotations
+
+import sys
+from dataclasses import dataclass
+
+
+class JSONShapeError(ValueError):
+    """A fixed diagnostic with no provider text in its arguments."""
+
+
+@dataclass(frozen=True, slots=True)
+class ShapeLimits:
+    max_bytes: int
+    max_units: int
+    max_depth: int
+    max_scalar_bytes: int
+
+    def __post_init__(self) -> None:
+        for value in (self.max_bytes, self.max_units, self.max_depth, self.max_scalar_bytes):
+            if type(value) is not int:
+                raise ValueError("integer_shape_limit_required")
+        if (
+            not 1 <= self.max_bytes <= sys.maxsize
+            or not 1 <= self.max_units <= self.max_bytes
+            or not 1 <= self.max_scalar_bytes <= self.max_bytes
+        ):
+            raise ValueError("invalid_shape_limit")
+        if not 0 <= self.max_depth <= self.max_units:
+            raise ValueError("invalid_shape_depth_limit")
+
+
+@dataclass(frozen=True, slots=True)
+class ShapeStats:
+    used_bytes: int
+    units: int
+    objects: int
+    arrays: int
+    colons: int
+    commas: int
+    strings: int
+    scalar_runs: int
+    maximum_depth: int
+
+
+def preflight_json_shape(
+    data: bytes | bytearray | memoryview,
+    *,
+    used: int,
+    limits: ShapeLimits,
+) -> ShapeStats:
+    """Reject excessive lexical shape without copying or building a graph.
+
+    Each outside-string punctuation byte ({}[]:,), string opening quote, or
+    scalar-run start spends one shared unit. A scalar run is a maximal span
+    outside strings excluding JSON whitespace, punctuation, and quotes. Runs
+    have a separate byte limit. Container kinds are not matched by this guard;
+    the stock parser owns that syntax check.
+    """
+    if type(used) is not int or not 0 <= used <= limits.max_bytes:
+        raise JSONShapeError("invalid_shape_byte_count")
+    if not isinstance(data, (bytes, bytearray, memoryview)):
+        raise TypeError("byte_storage_required")
+
+    # A new view object borrows the existing storage and is released here;
+    # a supplied caller memoryview remains usable. No cast or slice copies.
+    view = memoryview(data)
+    try:
+        if view.ndim != 1 or view.itemsize != 1 or view.format != "B" or not view.c_contiguous:
+            raise JSONShapeError("contiguous_unsigned_bytes_required")
+        if used > len(view):
+            raise JSONShapeError("shape_storage_shorter_than_used")
+
+        units = objects = arrays = colons = commas = strings = scalar_runs = 0
+        depth = maximum_depth = scalar_length = 0
+        in_string = escaped = False
+        index = 0
+        while index < used:
+            byte = view[index]
+            index += 1
+            if in_string:
+                if escaped:
+                    escaped = False
+                elif byte == 0x5C:  # backslash
+                    escaped = True
+                elif byte == 0x22:  # quote
+                    in_string = False
+                continue
+
+            if byte == 0x22:
+                in_string = True
+                escaped = False
+                scalar_length = 0
+                strings += 1
+                units += 1
+            elif byte == 0x7B or byte == 0x5B:  # { [
+                scalar_length = 0
+                units += 1
+                if byte == 0x7B:
+                    objects += 1
+                else:
+                    arrays += 1
+                depth += 1
+                if depth > limits.max_depth:
+                    raise JSONShapeError("json_shape_depth")
+                maximum_depth = max(maximum_depth, depth)
+            elif byte == 0x7D or byte == 0x5D:  # } ]
+                scalar_length = 0
+                units += 1
+                if depth == 0:
+                    raise JSONShapeError("json_shape_unmatched_close")
+                depth -= 1
+            elif byte == 0x3A or byte == 0x2C:  # : ,
+                scalar_length = 0
+                units += 1
+                if byte == 0x3A:
+                    colons += 1
+                else:
+                    commas += 1
+            elif byte == 0x20 or byte == 0x09 or byte == 0x0A or byte == 0x0D:
+                scalar_length = 0
+            else:
+                if scalar_length == 0:
+                    scalar_runs += 1
+                    units += 1
+                scalar_length += 1
+                if scalar_length > limits.max_scalar_bytes:
+                    raise JSONShapeError("json_shape_scalar_run")
+
+            if units > limits.max_units:
+                raise JSONShapeError("json_shape_units")
+
+        if in_string:
+            raise JSONShapeError("json_shape_unterminated_string")
+        if depth:
+            raise JSONShapeError("json_shape_unclosed_container")
+        return ShapeStats(
+            used, units, objects, arrays, colons, commas, strings, scalar_runs, maximum_depth
+        )
+    finally:
+        view.release()
