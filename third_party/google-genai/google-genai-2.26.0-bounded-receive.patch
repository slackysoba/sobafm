--- /dev/null
+++ b/google/genai/_bounded_receive.py
@@ -0,0 +1,274 @@
+"""Uninstalled bounded receive seam for google-genai 2.26.0 / websockets 16.1.1.
+
+No SDK, WebSocket, provider, socket, TLS, or native operation is imported here.
+The caller supplies one already-reserved bytearray and owns connection closure.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import AsyncIterator, Callable, Mapping
+from dataclasses import dataclass
+from typing import Any, Literal, Protocol
+
+if __package__:
+    from .json_shape_preflight import ShapeLimits, preflight_json_shape
+else:
+    from json_shape_preflight import ShapeLimits, preflight_json_shape
+
+
+class StreamingConnection(Protocol):
+    def recv_streaming(self, decode: Literal[False]) -> AsyncIterator[bytes]: ...
+
+
+class LegacyConnection(Protocol):
+    async def recv(self, *, decode: bool = True) -> Any: ...
+
+
+class ReceiveUnavailableError(RuntimeError):
+    """This receive owner cannot start or reuse a streaming message."""
+
+
+class AssemblyLimitError(RuntimeError):
+    """A fixed byte, fragment, or empty-fragment allowance was exceeded."""
+
+
+class State:
+    NEW = "new"
+    RECEIVING = "receiving"
+    COMPLETE = "complete"
+    UNUSABLE = "unusable"
+
+
+@dataclass(frozen=True)
+class BoundedReceiveOptions:
+    """Caller-reserved storage and explicit finite receive limits.
+
+    `max_size` and `max_queue` are forwarded to websockets.connect only when
+    this optional configuration is present. `max_size` is at most the reserved
+    byte allowance. Optional shape limits add a lexical preflight before JSON
+    copies; their byte cap cannot exceed `max_bytes`. The caller retains the
+    bytearray for the connection owner through preflight and parsing.
+    """
+
+    storage: bytearray
+    max_bytes: int
+    max_fragments: int
+    max_empty_fragments: int
+    max_size: int
+    max_queue: int
+    shape_limits: ShapeLimits | None = None
+
+    def __post_init__(self) -> None:
+        if type(self.storage) is not bytearray:
+            raise ValueError("caller_bytearray_required")
+        if type(self.max_bytes) is not int or not 0 < self.max_bytes <= len(self.storage):
+            raise ValueError("invalid_byte_allowance")
+        if type(self.max_fragments) is not int or self.max_fragments < 1:
+            raise ValueError("positive_fragment_allowance_required")
+        if (
+            type(self.max_empty_fragments) is not int
+            or not 0 <= self.max_empty_fragments <= self.max_fragments
+        ):
+            raise ValueError("invalid_empty_fragment_allowance")
+        if type(self.max_size) is not int or not 0 < self.max_size <= self.max_bytes:
+            raise ValueError("finite_websocket_message_limit_required")
+        if type(self.max_queue) is not int or self.max_queue < 1:
+            raise ValueError("finite_websocket_queue_limit_required")
+        if self.shape_limits is not None:
+            if type(self.shape_limits) is not ShapeLimits:
+                raise ValueError("invalid_json_shape_limits")
+            if self.shape_limits.max_bytes > self.max_bytes:
+                raise ValueError("shape_byte_limit_exceeds_receive_allowance")
+
+
+class BoundedReassembly:
+    """One message copied into reserved storage, with one-shot failure semantics."""
+
+    def __init__(
+        self,
+        connection: StreamingConnection,
+        options: BoundedReceiveOptions,
+    ) -> None:
+        self.connection = connection
+        self.buffer = options.storage
+        self._view = memoryview(self.buffer)[: options.max_bytes]
+        self._max_fragments = options.max_fragments
+        self._max_empty_fragments = options.max_empty_fragments
+        self._stream: AsyncIterator[bytes] | None = None
+        self.state = State.NEW
+        self.used = self.fragments_seen = self.empty_fragments_seen = 0
+
+    async def receive(self) -> int:
+        if self.state is not State.NEW:
+            raise ReceiveUnavailableError("one_shot_message_only")
+        self.state = State.RECEIVING
+        try:
+            self._stream = self.connection.recv_streaming(decode=False)
+            async for fragment in self._stream:
+                self.fragments_seen += 1
+                if self.fragments_seen > self._max_fragments:
+                    raise AssemblyLimitError("fragment_allowance")
+                if type(fragment) is not bytes:
+                    raise TypeError("recv_streaming_bytes_required")
+                size = len(fragment)
+                if size == 0:
+                    self.empty_fragments_seen += 1
+                    if self.empty_fragments_seen > self._max_empty_fragments:
+                        raise AssemblyLimitError("empty_fragment_allowance")
+                if size > len(self._view) - self.used:
+                    raise AssemblyLimitError("byte_capacity")
+                end = self.used + size
+                self._view[self.used : end] = fragment
+                self.used = end
+        except BaseException:
+            self.state = State.UNUSABLE
+            raise
+        self.state = State.COMPLETE
+        return self.used
+
+
+class BoundedReceiveSession:
+    """Serial reusable-on-success reader; any incomplete or failed message poisons it."""
+
+    def __init__(self, connection: StreamingConnection, options: BoundedReceiveOptions) -> None:
+        self.connection = connection
+        self.options = options
+        self.owner: BoundedReassembly | None = None
+        self.unusable = False
+        self._busy = False
+
+    def poison(self) -> None:
+        self.unusable = True
+
+    def _begin(self) -> None:
+        if self.unusable or self._busy:
+            raise ReceiveUnavailableError("connection_receive_unusable_or_in_flight")
+        self._busy = True
+
+    async def _collect(self) -> int:
+        stream_method = getattr(self.connection, "recv_streaming", None)
+        if not callable(stream_method):
+            raise ReceiveUnavailableError("public_recv_streaming_unavailable")
+        owner = BoundedReassembly(self.connection, self.options)
+        self.owner = owner
+        return await owner.receive()
+
+    async def discard_message(self) -> int:
+        """Drain the connection prelude without building a fragment list or text copy."""
+        self._begin()
+        try:
+            return await self._collect()
+        except BaseException:
+            self.poison()
+            raise
+        finally:
+            self._busy = False
+
+    async def receive_json(self) -> Any:
+        """Assemble and parse one message; copies are explicit and failure poisons reuse."""
+        self._begin()
+        try:
+            used = await self._collect()
+            if used == 0:
+                return {}
+            if self.options.shape_limits is not None:
+                preflight_json_shape(
+                    self.options.storage,
+                    used=used,
+                    limits=self.options.shape_limits,
+                )
+
+            # recv_streaming yields bytes. The reserved buffer is borrowed by
+            # memoryview; this explicit bytes copy and UTF-8 text copy are the
+            # JSON input allocations, and are released before the next receive.
+            payload = bytes(memoryview(self.options.storage)[:used])
+            try:
+                try:
+                    text = payload.decode("utf-8")
+                except UnicodeDecodeError as error:
+                    # Both .object and args[1] retain the entire copied input.
+                    error.object = b""
+                    error.args = (
+                        error.encoding,
+                        b"",
+                        error.start,
+                        error.end,
+                        error.reason,
+                    )
+                    error.__traceback__ = None
+                    raise ValueError("Invalid UTF-8 bounded response") from None
+            finally:
+                del payload
+            try:
+                try:
+                    response = json.loads(text)
+                except json.decoder.JSONDecodeError as error:
+                    # JSONDecodeError.doc retains the whole input string. Clear
+                    # it before raising a bounded diagnostic with no raw payload.
+                    error.doc = ""
+                    error.__traceback__ = None
+                    raise ValueError("Failed to parse bounded response") from None
+            finally:
+                del text
+            return response
+        except BaseException:
+            self.poison()
+            raise
+        finally:
+            self._busy = False
+
+
+async def receive_json_compat(
+    connection: LegacyConnection,
+    bounded: BoundedReceiveSession | None,
+) -> Any:
+    """Use streaming only when opted in; preserve the SDK's legacy recv path otherwise."""
+    if bounded is not None:
+        return await bounded.receive_json()
+
+    try:
+        raw_response = await connection.recv(decode=False)
+    except TypeError:
+        raw_response = await connection.recv()
+    if raw_response:
+        try:
+            return json.loads(raw_response)
+        except json.decoder.JSONDecodeError:
+            raise ValueError(f"Failed to parse response: {raw_response!r}")
+    return {}
+
+
+def websocket_connect_kwargs(
+    headers: Mapping[str, str],
+    *,
+    compression: Literal["deflate"] | None = "deflate",
+    bounded_receive: BoundedReceiveOptions | None = None,
+    legacy_header_name: bool = False,
+) -> dict[str, Any]:
+    """Only opt-in bounded connections override WebSocket's finite queue/message knobs."""
+    kwargs: dict[str, Any] = {
+        "extra_headers" if legacy_header_name else "additional_headers": dict(headers),
+        "compression": compression,
+    }
+    if bounded_receive is not None:
+        kwargs["max_size"] = bounded_receive.max_size
+        kwargs["max_queue"] = bounded_receive.max_queue
+    return kwargs
+
+
+def connect_with_header_fallback(
+    connect: Callable[..., Any],
+    uri: str,
+    kwargs: dict[str, Any],
+) -> Any:
+    """Mirror the SDK's current additional_headers to extra_headers fallback."""
+    try:
+        return connect(uri, **kwargs)
+    except TypeError:
+        if "additional_headers" not in kwargs:
+            raise
+        legacy_kwargs = dict(kwargs)
+        legacy_kwargs["extra_headers"] = legacy_kwargs.pop("additional_headers")
+        return connect(uri, **legacy_kwargs)
+
