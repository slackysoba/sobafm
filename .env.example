# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=

# Google AI Studio → API keys (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: the Gemini model that interprets requests (default: gemini-3.5-flash-lite)
# SOBAFM_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: DEBUG, INFO (default), WARNING, or ERROR
# SOBAFM_LOG_LEVEL=INFO

# Optional: directory for SobaFM's database (default: data)
# SOBAFM_DATA_DIR=data

# Optional: most Lyria RealTime sessions at once, an even number; each playing server uses two (default: 4)
# SOBAFM_MAX_SESSIONS=4

# Optional, for development: register slash commands to one server, where they update instantly.
# Requires a separate Discord application without global commands; startup refuses coexistence.
# To retire old guild registrations, see docs/self-hosting.md#duplicate-slash-commands.
# SOBAFM_DEV_GUILD_ID=
