# Placeholder-only example. Copy to .env for Docker Compose and replace the values;
# never commit the real file.
# Required: the Discord bot token. SobaFM removes it from its environment at startup.
SOBAFM_DISCORD_TOKEN=replace-with-your-bot-token
# Required: the settings database, on the writable volume Compose mounts at /data.
SOBAFM_DATABASE=/data/sobafm.db
# Optional together: a prepared catalog snapshot, its separate trusted admission
# reviews, the media manifest that locates each recording's local file and a
# Gemini API key for matching requests. Without them /play is not registered.
# The files live in ./catalog, which Compose mounts read-only at /catalog.
# SobaFM removes the key from its environment at startup.
SOBAFM_CATALOG=/catalog/catalog.json
SOBAFM_REVIEWS=/catalog/reviews.json
SOBAFM_MEDIA=/catalog/media.json
SOBAFM_GEMINI_API_KEY=replace-with-your-gemini-api-key
