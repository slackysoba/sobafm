# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=

# Google AI Studio → API keys (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: DEBUG, INFO (default), WARNING, or ERROR
# SOBAFM_LOG_LEVEL=INFO

# Optional: directory for SobaFM's database (default: data)
# SOBAFM_DATA_DIR=data

# Optional, for development: register slash commands to one server, where they update instantly
# SOBAFM_DEV_GUILD_ID=
