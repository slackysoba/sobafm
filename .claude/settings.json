{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(uv sync --locked)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright*)",
      "Bash(uv run pytest*)",
      "Bash(uv run pre-commit *)",
      "Bash(uv run python -m pytest*)",
      "Bash(uv run python -m pyright*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git fetch*)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git push -u origin *)",
      "Bash(git push --force-with-lease origin *)",
      "Bash(git worktree *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh project view *)",
      "Bash(gh project item-list *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)",
      "Bash(gh project field-list *)",
      "PowerShell(uv sync --locked)",
      "PowerShell(uv run ruff *)",
      "PowerShell(uv run pyright*)",
      "PowerShell(uv run pytest*)",
      "PowerShell(uv run pre-commit *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git fetch*)",
      "PowerShell(gh issue *)",
      "PowerShell(gh pr *)",
      "PowerShell(gh project view *)",
      "PowerShell(gh project item-list *)"
    ],
    "ask": [
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh pr merge *)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git worktree remove --force *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git push origin --delete *)",
      "Bash(git push * --delete *)",
      "PowerShell(gh issue delete *)",
      "PowerShell(gh issue transfer *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.bak)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh release delete *)"
    ]
  }
}
